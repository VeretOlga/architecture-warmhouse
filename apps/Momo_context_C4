@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Контекстная диаграмма системы «Умный дом»

Person(пользователь, "Пользователи")

System(умный_дом, "Умный дом", "Приложение для управления отоплением и мониторингом температуры в домах")

System_Ext(датчики, "Датчики системы отопления в доме", "Датчики")

System_Ext(база_данных, "База данных")

Rel(пользователь, умный_дом, "")
Rel(умный_дом, датчики, "Запрашивает данные / управляет")
Rel(датчики, умный_дом,  "Регистрируется при старте")

Rel(умный_дом, база_данных, "Читает / записывает")
@enduml
